default_platform(:android)

# CE-owned: builds the phone and TV bundles and uploads them to Google Play.
#
# Phone and TV share one application ID (ADR 0005). Play serves them through separate tracks: the
# phone bundle goes to `track`, the TV bundle to the Android TV form factor track `tv:<track>`. The
# TV bundle's versionCode is one higher (EphyraVersion.TV_CODE), so both fit in one app.
#
# Flavors (#641): the phone bundle is `proprietary`, with Google Cast; Play users have Google Play
# services anyway. The TV bundle is `libre` (app/tv has no other flavor). F-Droid and Amazon stay
# `libre`; GitHub releases and betas carry both phone flavors (release.yml, beta.yml).
#
# Signing: the bundles are signed with the Play *upload* key, through the same KEYSTORE_* variables
# that release.yml uses for the release key. Play re-signs them with the app signing key.
#
# Lanes: `deploy` builds the bundles and runs `upload`. `upload` only uploads bundles that are
# already built; play.yml builds them with Gradle first, so they are kept even when it can't upload.
#
# R8 mappings: each bundle carries its own (BUNDLE-METADATA/com.android.tools.build.obfuscation/
# proguard.map), which Play uses to deobfuscate crashes, so they are not uploaded separately.
#
# Environment:
#   KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD  upload key (deploy only)
#   PLAY_API_CREDENTIALS                                      path to the service account JSON key
#
# Examples:
#   fastlane android deploy                                   closed test (alpha), phone and TV
#   fastlane android deploy track:production
#   fastlane android deploy tv:false                          phone only (before Android TV is enabled)
#   fastlane android deploy release_status:draft              needed until the app's first release is live
#   fastlane android upload tv:false release_status:draft     the same, without building
platform :android do
  # Paths from the repository root, where fastlane runs its actions.
  PHONE_AAB = "app/phone/build/outputs/bundle/proprietaryRelease/phone-proprietary-release.aab"
  TV_AAB = "app/tv/build/outputs/bundle/libreRelease/tv-libre-release.aab"

  desc "Build the phone and TV bundles and upload them to a Play track"
  lane :deploy do |options|
    tv = options.fetch(:tv, true).to_s != "false"

    gradle(task: "clean")
    gradle(
      tasks: ["app:phone:bundleProprietaryRelease"] + (tv ? ["app:tv:bundleLibreRelease"] : []),
      print_command: false,
    )

    upload(options)
  end

  desc "Upload the built phone and TV bundles to a Play track"
  lane :upload do |options|
    track = options.fetch(:track, "alpha")
    release_status = options.fetch(:release_status, "completed")
    tv = options.fetch(:tv, true).to_s != "false"

    upload_to_play_store(
      track: track,
      release_status: release_status,
      aab: PHONE_AAB,
      json_key: ENV["PLAY_API_CREDENTIALS"],
      sync_image_upload: true,
    )

    if tv
      upload_to_play_store(
        track: "tv:#{track}",
        release_status: release_status,
        aab: TV_AAB,
        json_key: ENV["PLAY_API_CREDENTIALS"],
        # The listing is shared with the phone upload above.
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
      )
    end
  end
end
