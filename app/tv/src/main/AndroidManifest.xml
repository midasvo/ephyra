<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!--
         CE (#1045): what libraries ask for and the TV app does not use. TvManifestTest pins the
         list, so a permission a new dependency merges in fails the build until someone decides.

         WorkManager uses WAKE_LOCK and FOREGROUND_SERVICE only for foreground work, and no worker
         here calls setForeground or setExpedited. A worker that starts to needs them back, with
         the SystemForegroundService removed below.
    -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <!-- Watch Next reads and writes its own rows only, which WRITE_EPG_DATA covers. -->
    <uses-permission
        android:name="com.android.providers.tv.permission.READ_EPG_DATA"
        tools:node="remove" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".BaseApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@mipmap/ic_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Findroid">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:theme="@style/Theme.Findroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- CE (#138): the launcher reports a program the user removed from the Watch Next row. -->
        <receiver
            android:name=".ce.watchnext.WatchNextRemovedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.action.WATCH_NEXT_PROGRAM_BROWSABLE_DISABLED" />
            </intent-filter>
        </receiver>

        <!-- CE (#140): Android TV screensaver -->
        <service
            android:name=".ce.presentation.screensaver.ScreensaverService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:banner="@mipmap/ic_banner"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/screensaver_dream" />
        </service>

        <activity
            android:name=".ce.presentation.screensaver.ScreensaverSettingsActivity"
            android:exported="true"
            android:label="@string/pref_tv_screensaver_title"
            android:theme="@style/Theme.Findroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <!-- WorkManager is set up by BaseApplication, with the Hilt worker factory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- CE (#1045): WorkManager's service for foreground work (see the permissions above). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
        <!-- CE (#1045): WorkManager's dump over adb, which a TV app has no use for. -->
        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />
        <!--
             Kept on purpose: Media3's BluetoothValidationActivity (Bluetooth media buttons find
             the app through it on Android 16 and 17) and profileinstaller's ProfileInstallReceiver
             (the baseline profile). The BLUETOOTH_PRIVILEGED and DUMP they carry guard those
             components; the app does not ask for either.
        -->
    </application>

</manifest>
