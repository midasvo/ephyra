// Generated by architecture/…/GeneratedDocsTest.kt from the build files and the rule tests. Don't edit:
// EPHYRA_WRITE_GENERATED=1 ./gradlew :architecture:test --rerun --tests '*GeneratedDocsTest*'

model {
  extend ephyra {
    appPhone = app 'app/phone' {
      description 'The phone app: screens, navigation and layouts; with app/tv the composition root.'
      link https://github.com/midasvo/ephyra/tree/main/app/phone 'Source'
    }
    appTv = app 'app/tv' {
      description 'The Android TV app: its own screens in its ce package, next to upstream\'s (TV ADR 0001).'
      link https://github.com/midasvo/ephyra/tree/main/app/tv 'Source'
    }
    application = application 'application' {
      description 'Pure Kotlin: the repository\'s roles (ItemCatalog, ItemLists, PlaybackMedia, …) and their implementation MediaRepositoryImpl over the server\'s ports and the stores, the store ports (the roles of the server and download stores, PendingUserDataStore) and the event flows (DataChangeEvents, ReloadPolicy, …).'
      link https://github.com/midasvo/ephyra/tree/main/application 'Source'
    }
    architecture = tooling 'architecture' {
      description 'The Konsist rules over the source tree, their allowlists in architecture/baseline/, and the generated architecture docs.'
      link https://github.com/midasvo/ephyra/tree/main/architecture 'Source'
    }
    baselineprofile = tooling 'baselineprofile' {
      description 'Macrobenchmark: the baseline profile and startup benchmark of app/phone.'
      link https://github.com/midasvo/ephyra/tree/main/baselineprofile 'Source'
    }
    baselineprofileTv = tooling 'baselineprofile-tv' {
      description 'Macrobenchmark: the baseline profile and startup benchmark of app/tv.'
      link https://github.com/midasvo/ephyra/tree/main/baselineprofile-tv 'Source'
    }
    core = feature 'core' {
      description 'Hilt modules, the server in use (CurrentMediaServer), its session keeper and reachability, the sync worker, DownloaderViewModel, MainViewModel and shared Composables.'
      link https://github.com/midasvo/ephyra/tree/main/core 'Source'
    }
    data = adapter 'data' {
      description 'Room: the database and the stores (Room*Store) behind the store ports, and the downloaded files (DownloadedFilesOnDisk); no SDK, and of Android only Room (R20).'
      link https://github.com/midasvo/ephyra/tree/main/data 'Source'
    }
    device = adapter 'device' {
      description 'The adapters over the device: the codec probe (DeviceCodecs, what the device profile is built from) and the connectivity check (NetworkConnectivity), with its own Hilt module.'
      link https://github.com/midasvo/ephyra/tree/main/device 'Source'
    }
    domain = domain 'domain' {
      description 'Pure Kotlin, no Android or SDK: the models (Item, Movie, ItemSource, …), the ids, PlayState, DownloadState, Ticks, ActiveServer and the server ports.'
      link https://github.com/midasvo/ephyra/tree/main/domain 'Source'
    }
    downloads = feature 'downloads' {
      description 'The download engine (Downloader, DownloaderImpl, MediaDownloadEngine), DownloadQueue, smart downloads and their workers.'
      link https://github.com/midasvo/ephyra/tree/main/downloads 'Source'
    }
    http = shared 'http' {
      description 'MediaHttpClient, the API\'s OkHttp client: provided by server/jellyfin, used by the player (ExoPlayer\'s media, mpv\'s subtitle files), so they share the API\'s connections.'
      link https://github.com/midasvo/ephyra/tree/main/http 'Source'
    }
    modesFilm = feature 'modes/film' {
      description 'The view models with their State and Action classes for home, library, search, the item screens and downloads.'
      link https://github.com/midasvo/ephyra/tree/main/modes/film 'Source'
    }
    playerCast = feature 'player/cast' {
      description 'Google Cast: the session and playback on a receiver; real in the proprietary flavour, stubs in libre.'
      link https://github.com/midasvo/ephyra/tree/main/player/cast 'Source'
    }
    playerCore = feature 'player/core' {
      description 'The player models shared by the player and its callers: PlayerItem, Track, Trickplay.'
      link https://github.com/midasvo/ephyra/tree/main/player/core 'Source'
    }
    playerLocal = feature 'player/local' {
      description 'The player: PlayerViewModel and playback, on ExoPlayer or mpv behind PlayerEngine (in its engine package).'
      link https://github.com/midasvo/ephyra/tree/main/player/local 'Source'
    }
    ratingsMdblist = adapter 'ratings/mdblist' {
      description 'The MDBList adapter of the external ratings on the movie and show pages: its HTTP client and the ratings cache on disk, with its own Hilt module.'
      link https://github.com/midasvo/ephyra/tree/main/ratings/mdblist 'Source'
    }
    serverJellyfin = adapter 'server/jellyfin' {
      description 'The Jellyfin adapter, the only module with the Jellyfin SDK: JellyfinApi, the mappers, the port implementations, the device profiles and its own Hilt module.'
      link https://github.com/midasvo/ephyra/tree/main/server/jellyfin 'Source'
    }
    settings = feature 'settings' {
      description 'AppPreferences (over SharedPreferences), SettingsViewModel and the preference models; the screens are in the apps.'
      link https://github.com/midasvo/ephyra/tree/main/settings 'Source'
    }
    setup = feature 'setup' {
      description 'Server discovery, signing in and the onboarding flow.'
      link https://github.com/midasvo/ephyra/tree/main/setup 'Source'
    }
    testing = tooling 'testing' {
      description 'Test only (R8): FakeMediaServer, FakeServerConnector and the contract suites a server adapter passes.'
      link https://github.com/midasvo/ephyra/tree/main/testing 'Source'
    }

    appPhone -> application
    appPhone -> baselineprofile
    appPhone -> core
    appPhone -> data
    appPhone -> device
    appPhone -> domain
    appPhone -> downloads
    appPhone -> http
    appPhone -> modesFilm
    appPhone -> playerCast
    appPhone -> playerCore
    appPhone -> playerLocal
    appPhone -> ratingsMdblist
    appPhone -> serverJellyfin
    appPhone -> settings
    appPhone -> setup
    appTv -> application
    appTv -> core
    appTv -> data
    appTv -> device
    appTv -> domain
    appTv -> downloads
    appTv -> http
    appTv -> modesFilm
    appTv -> playerCore
    appTv -> playerLocal
    appTv -> ratingsMdblist
    appTv -> serverJellyfin
    appTv -> settings
    appTv -> setup
    appTv -[test]-> testing
    application -> domain
    application -[test]-> testing
    baselineprofile -> appPhone
    baselineprofileTv -> appTv
    core -> application
    core -[test]-> data
    core -> domain
    core -> downloads
    core -> playerCore
    core -> settings
    core -[test]-> testing
    data -> application
    data -> domain
    data -[test]-> testing
    device -> application
    device -> domain
    downloads -> application
    downloads -[test]-> data
    downloads -> domain
    downloads -> settings
    downloads -[test]-> testing
    modesFilm -> application
    modesFilm -> core
    modesFilm -[test]-> data
    modesFilm -> domain
    modesFilm -> downloads
    modesFilm -> settings
    modesFilm -[test]-> testing
    playerCast -> application
    playerCast -> core
    playerCast -> domain
    playerCast -> playerCore
    playerCast -> playerLocal
    playerCast -> settings
    playerCast -[test]-> testing
    playerCore -> domain
    playerLocal -> application
    playerLocal -> core
    playerLocal -[test]-> data
    playerLocal -> domain
    playerLocal -> http
    playerLocal -> playerCore
    playerLocal -> settings
    playerLocal -[test]-> testing
    ratingsMdblist -> application
    ratingsMdblist -> domain
    serverJellyfin -> application
    serverJellyfin -[test]-> data
    serverJellyfin -[test]-> device
    serverJellyfin -> domain
    serverJellyfin -> http
    serverJellyfin -[test]-> settings
    serverJellyfin -[test]-> testing
    settings -> application
    settings -> domain
    setup -> application
    setup -> core
    setup -[test]-> data
    setup -> domain
    setup -> settings
    setup -[test]-> testing
    testing -> application
    testing -> domain
  }
}
